# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for spv-wallet-go-client
# Load Order: 90 (loaded after all defaults, overrides tool-specific settings)
#
# This file contains configuration specific to this project that overrides
# defaults from earlier env files (00-core, 10-*, 20-*).
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Project Go versions (overrides 00-core.env defaults)
GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x


# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection (override: use codecov instead of internal)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🪄 MAGE-X CONFIGURATION
# ================================================================================================

# Exclude regression tests from build tag auto-discovery (they require Docker, external APIs, and long sync times)
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,regression
MAGE_X_BUILD_EXCLUDE_PATTERN=regression
MAGE_X_TEST_EXCLUDE_MODULES=regression

# ================================================================================================
# 🔒 SECURITY CONFIGURATION
# ================================================================================================

# Gitleaks Configuration (project-specific config file)
GITLEAKS_CONFIG_FILE=.github/.gitleaks.toml

# Govulncheck/Magex CVE Exclusions (known acceptable vulnerabilities)
# Format: comma-separated CVE IDs (e.g., CVE-9999-12345,CVE-9999-43210)
MAGE_X_CVE_EXCLUDES=GO-2026-5932
